rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada tarea pertenece a un usuario (campo userId). Solo su dueño puede leerla o modificarla.
    match /tasks/{taskId} {
      function isOwner() {
        return request.auth != null && resource.data.userId == request.auth.uid;
      }

      function isValidTask(task) {
        return task.title is string
          && task.title.size() > 0
          && task.title.size() <= 100
          && task.description is string
          && task.description.size() <= 500
          && task.completed is bool
          && task.priority in ['low', 'medium', 'high'];
      }

      allow read: if isOwner();

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && isValidTask(request.resource.data);

      allow update: if isOwner()
        && request.resource.data.userId == resource.data.userId
        && isValidTask(request.resource.data);

      allow delete: if isOwner();
    }

    // Todo lo demás (incluida la colección interna mailRateLimit, que solo toca el backend
    // con el Admin SDK) queda denegado para los clientes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
