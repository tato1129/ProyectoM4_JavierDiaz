# Copiá este archivo a .env y completá los valores. NO subas .env al repositorio.

# ── Frontend (Vite) ─────────────────────────────────────────────
# Config web de Firebase (Project settings > General > Your apps).
# Estos valores identifican el proyecto y no son secretos; la seguridad
# la dan las Firestore Security Rules y la verificación del token en el servidor.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ── Servidor (Vercel Functions) — SECRETOS, solo en backend ─────
# Cuenta de servicio de Firebase (Project settings > Service accounts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pegá la clave privada completa; se aceptan saltos de línea reales o "\n" escapados.
FIREBASE_PRIVATE_KEY=

# AWS SES (usuario IAM con permiso ses:SendEmail).
# Se usa el prefijo SES_ para no chocar con variables AWS_* del runtime de Vercel.
SES_AWS_REGION=
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
# Remitente verificado en SES (identidad de email o dominio).
SES_FROM_EMAIL=
